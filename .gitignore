# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Never commit real single-cell objects — they are patient or animal data
*.h5ad
*.rds
*.h5Seurat
*.loom
*.zip
# ...except the synthetic test objects, which scripts/make-family-fixture.py writes from
# made-up names and numbers (nothing real may ever replace them)
!scripts/fixtures/*.h5ad
# ...and the synthetic Seurat objects scripts/make-seurat-fixtures.R writes (random
# counts, made-up names; nothing real may ever replace them)
!scripts/fixtures/seurat-*.rds
.verify-tmp/
